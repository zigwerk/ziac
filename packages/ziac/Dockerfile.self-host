FROM docker.io/library/debian:bookworm-slim@sha256:60eac759739651111db372c07be67863818726f754804b8707c90979bda511df AS build
ARG ZIG_VERSION=0.16.0
ARG ZIG_SHA256=70e49664a74374b48b51e6f3fdfbf437f6395d42509050588bd49abe52ba3d00
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl libc6-dev libssl-dev xz-utils && rm -rf /var/lib/apt/lists/*
RUN curl --fail --location --proto '=https' --tlsv1.2 --output /tmp/zig.tar.xz "https://ziglang.org/download/${ZIG_VERSION}/zig-x86_64-linux-${ZIG_VERSION}.tar.xz" \
    && echo "${ZIG_SHA256}  /tmp/zig.tar.xz" | sha256sum -c - \
    && tar -xJf /tmp/zig.tar.xz -C /opt \
    && mv "/opt/zig-x86_64-linux-${ZIG_VERSION}" /opt/zig \
    && rm /tmp/zig.tar.xz
COPY . /src
WORKDIR /src/ziac
RUN /opt/zig/zig build self-host-binaries -Doptimize=ReleaseSafe -Dopenssl_include_path=/usr/include/x86_64-linux-gnu --prefix /out

FROM docker.io/library/debian:bookworm-slim@sha256:60eac759739651111db372c07be67863818726f754804b8707c90979bda511df AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libssl3 && rm -rf /var/lib/apt/lists/*
RUN useradd --system --uid 65532 --no-create-home ziac
USER 65532:65532
ENV PORT=8080
EXPOSE 8080

FROM runtime AS control-plane
COPY --from=build --chown=65532:65532 /out/bin/ziac-estate-control-plane /app
ENTRYPOINT ["/app"]

FROM runtime AS billing-worker
COPY --from=build --chown=65532:65532 /out/bin/ziac-billing-worker /app
ENTRYPOINT ["/app"]
